17:["$","$L20",null,{"deviceType":"charging port repair","title":"Frequently Asked Questions About Charging Port Repair","faqs":[{"question":"How much does charging port repair cost in Macon?","answer":"Pricing depends on the device model and issue. Call (478) 259-6371 to discuss your device and request a quote."},{"question":"How long does charging port repair take?","answer":"Timing depends on the issue, model, and parts availability. We can provide an estimate after discussing or inspecting your device."},{"question":"Do I need an appointment?","answer":"Walk-ins are welcome at 3742 Eisenhower Parkway in Macon. You can also call ahead to discuss your repair."},{"question":"Can a charging port be cleaned instead of replaced?","answer":"Sometimes debris prevents a good connection. We can inspect the port and discuss cleaning or repair based on its condition."},{"question":"What if my phone charges wirelessly but not by cable?","answer":"The cable, charging port, or another issue may be responsible. Bring it in for an assessment."}]}]
