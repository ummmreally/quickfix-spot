16:["$","section",null,{"className":"py-16 px-4","children":["$","div",null,{"className":"max-w-6xl mx-auto","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-foreground mb-4 text-center","children":["iPhone Problems We See Most Often from ","Perry"," Customers"]}],["$","p",null,{"className":"text-muted-foreground text-center mb-12 max-w-3xl mx-auto","children":["Every city sends us a slightly different mix of repairs. Here's what ","Perry"," residents bring in most."]}],["$","div",null,{"className":"grid md:grid-cols-3 gap-6","children":[["$","article","Cracked Screens After Fairgrounds Events",{"className":"bg-card border border-border rounded-lg p-6","children":[["$","h3",null,{"className":"text-xl font-bold text-foreground mb-3","children":"Cracked Screens After Fairgrounds Events"}],["$","p",null,{"className":"text-muted-foreground text-sm leading-relaxed","children":"The Georgia National Fair, Mossy Oak Properties events, and livestock shows all generate a wave of dropped phones. We pre-stock iPhone 14, 15, and 16 screens before Fair week so Perry walk-ins don't wait."}]]}],["$","article","Battery Drain from Robins AFB Commutes",{"className":"bg-card border border-border rounded-lg p-6","children":[["$","h3",null,{"className":"text-xl font-bold text-foreground mb-3","children":"Battery Drain from Robins AFB Commutes"}],["$","p",null,{"className":"text-muted-foreground text-sm leading-relaxed","children":"Perry-to-Robins commuters running CarPlay plus navigation plus hotspot are hard on batteries. We see early-life battery replacement requests on 2-year-old iPhones from this corridor often. Premium-cell replacement in ~30 minutes."}]]}],["$","article","Charging Port Failures from Truck/Vehicle Mounts",{"className":"bg-card border border-border rounded-lg p-6","children":[["$","h3",null,{"className":"text-xl font-bold text-foreground mb-3","children":"Charging Port Failures from Truck/Vehicle Mounts"}],["$","p",null,{"className":"text-muted-foreground text-sm leading-relaxed","children":"Vibration from work trucks and tractors loosens Lightning and USB-C connectors faster than typical use. We clean or replace the charging port and confirm fast-charge functionality before you leave."}]]}]]}]]}]}]
17:["$","section",null,{"className":"py-12 px-4 bg-secondary/20","children":["$","div",null,{"className":"max-w-4xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-foreground mb-4","children":["Directions from ","Perry"," to Tech Medics"]}],["$","p",null,{"className":"text-lg text-muted-foreground mb-6 leading-relaxed","children":"From Perry, head north on I-75 toward Macon, then take Exit 164 (Eisenhower Parkway). At the top of the ramp, turn left (west) and Tech Medics is just past the Mercer University Drive intersection on the right, at 3742 Eisenhower Parkway. Plan on roughly 25 minutes door-to-door with normal traffic."}],["$","a",null,{"href":"https://www.google.com/maps/dir/Perry%2C%20GA/3742+Eisenhower+Parkway,+Macon,+GA+31206","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center gap-2 text-primary hover:underline font-semibold","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin w-5 h-5","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"}],["$","circle","ilqhr7",{"cx":"12","cy":"10","r":"3"}],"$undefined"]}],"Open Driving Directions in Google Maps →"]}]]}]}]
18:["$","section",null,{"className":"py-16 px-4","children":["$","div",null,{"className":"max-w-4xl mx-auto","children":[["$","h2",null,{"className":"text-3xl font-bold text-foreground mb-6","children":["About iPhone Repair in ","Perry",", ","GA"]}],["$","p",null,{"className":"text-muted-foreground text-lg leading-relaxed","children":"Perry's population of about 19,000 makes it the largest city in southern Houston County, and the combination of fairground tourism, Robins AFB contractors, and Perry Senior High students keeps device-repair demand steady year-round. Because Apple does not have a brick-and-mortar location closer than Atlanta or Augusta, Perry customers who want hands-on, same-day iPhone service rely on shops like Tech Medics. We treat the Perry market seriously — we stock parts for every iPhone model from the 7 to the 16 Pro Max, offer a 30-day warranty on parts and labor, and can also handle iPad and MacBook repairs in the same visit so a single trip to Macon covers a household's devices."}]]}]}]
19:["$","$L22",null,{"deviceType":"iPhone","faqs":[{"question":"Is Tech Medics worth the drive from Perry?","answer":"For same-day repair, yes. The next-closest Apple-experienced shops are an hour-plus to Atlanta, and Apple Stores are even further. From Perry, the door-to-door drive is about 25 minutes, and most screen repairs finish in 30 minutes — so a typical visit is under 90 minutes total."},{"question":"Do you stock screens for the older iPhones still common in Perry?","answer":"Yes. We stock iPhone 8, X, XR, 11, 12, 13 screens regularly, and we can also repair iPhone 7 and SE models. Call ahead at (478) 259-6371 only if you have a particularly rare model."},{"question":"Can you fix iPhones for the Georgia National Fairgrounds vendors?","answer":"Yes — Fair-week is one of our busiest times. We've handled emergency repairs for vendors, exhibitors, and performers. Call first during Fair week and we'll prioritize the part you need."},{"question":"Do you offer warranty on repairs done for Perry customers?","answer":"Every repair includes a 30-day warranty on parts and labor regardless of where you live. If anything related to the repair fails within 30 days, bring the device back and we'll make it right."}]}]
