14:["$","section",null,{"className":"py-16 px-4","children":["$","div",null,{"className":"max-w-4xl mx-auto prose prose-lg","children":[["$","p","0",{"className":"text-muted-foreground text-lg leading-relaxed mb-6","children":"Perry residents looking for fast, affordable iPhone repair drive about 25 minutes north on I-75 to reach Tech Medics. We are the closest dedicated Apple-focused repair shop with same-day screen and battery service — every other option from Perry is either an hour to Atlanta or a multi-day mail-in."}],["$","p","1",{"className":"text-muted-foreground text-lg leading-relaxed mb-6","children":"We work on a steady stream of Perry customers, especially during Georgia National Fair week each October and during the Atlanta Motorsports Park events at the fairgrounds. Concrete pavilions, packed crowds, and cell-phones-as-cameras add up to a lot of cracked screens — and we keep extra stock in October to absorb the spike."}]]}]}]
