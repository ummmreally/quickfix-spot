11:T5a3,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Tech Medics worth the drive from Perry?","acceptedAnswer":{"@type":"Answer","text":"For same-day repair, yes. The next-closest Apple-experienced shops are an hour-plus to Atlanta, and Apple Stores are even further. From Perry, the door-to-door drive is about 25 minutes, and most screen repairs finish in 30 minutes — so a typical visit is under 90 minutes total."}},{"@type":"Question","name":"Do you stock screens for the older iPhones still common in Perry?","acceptedAnswer":{"@type":"Answer","text":"Yes. We stock iPhone 8, X, XR, 11, 12, 13 screens regularly, and we can also repair iPhone 7 and SE models. Call ahead at (478) 259-6371 only if you have a particularly rare model."}},{"@type":"Question","name":"Can you fix iPhones for the Georgia National Fairgrounds vendors?","acceptedAnswer":{"@type":"Answer","text":"Yes — Fair-week is one of our busiest times. We've handled emergency repairs for vendors, exhibitors, and performers. Call first during Fair week and we'll prioritize the part you need."}},{"@type":"Question","name":"Do you offer warranty on repairs done for Perry customers?","acceptedAnswer":{"@type":"Answer","text":"Every repair includes a 30-day warranty on parts and labor regardless of where you live. If anything related to the repair fails within 30 days, bring the device back and we'll make it right."}}]}9:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://techmedicsmacon.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Macon\",\"item\":\"https://techmedicsmacon.com/macon\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Perry iPhone Repair\",\"item\":\"https://techmedicsmacon.com/macon/perry-iphone-repair\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://techmedicsmacon.com/macon/perry-iphone-repair#service\",\"serviceType\":\"iPhone Repair\",\"name\":\"iPhone Repair Service for Perry, GA\",\"description\":\"iPhone repair for Perry GA & southern Houston County. 25 min from Georgia National Fairgrounds via I-75 Exit 135. Same-day screen & battery. Call (478) 259-6371.\",\"provider\":{\"@type\":\"LocalBusiness\",\"@id\":\"https://techmedicsmacon.com/#business\",\"name\":\"Tech Medics Macon\",\"telephone\":\"(478) 259-6371\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"3742 Eisenhower Parkway\",\"addressLocality\":\"Macon\",\"addressRegion\":\"GA\",\"postalCode\":\"31206\",\"addressCountry\":\"US\"}},\"areaServed\":[{\"@type\":\"City\",\"name\":\"Perry\",\"containedIn\":{\"@type\":\"AdministrativeArea\",\"name\":\"Houston County\"}},{\"@type\":\"AdministrativeArea\",\"name\":\"Houston County\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"max-w-7xl mx-auto px-4 py-3 text-sm text-muted-foreground","children":["$","ol",null,{"className":"flex items-center gap-2","children":[["$","li",null,{"children":["$","$L12",null,{"href":"/","className":"hover:text-primary","children":"Home"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"children":["$","$L12",null,{"href":"/macon","className":"hover:text-primary","children":"Macon"}]}],["$","li",null,{"children":"/"}],["$","li",null,{"className":"text-foreground font-medium","children":["Perry"," iPhone Repair"]}]]}]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b"],null,"$L1c"]}]
