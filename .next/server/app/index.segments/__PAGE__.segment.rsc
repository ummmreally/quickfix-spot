cement."]}],["$","h3",null,{"className":"text-2xl font-bold mb-4 text-foreground mt-8","children":"Why Choose Tech Medics for iPhone Screen Repair in Macon?"}],["$","p",null,{"className":"text-muted-foreground mb-4","children":"As Macon's most trusted Apple repair center, we combine fast turnaround times with quality workmanship. Walk-ins are always welcome – no appointment necessary. Every repair is backed by our warranty, and we use high-quality replacement parts."}],["$","p",null,{"className":"text-muted-foreground","children":[["$","strong",null,{"children":"Serving Macon, GA and surrounding areas"}]," including Warner Robins, Byron, Forsyth, and all of Bibb County with professional Apple device repair services since 2010."]}]]}]}]}]
