f:Tb41,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long do repairs take at your Macon location?","acceptedAnswer":{"@type":"Answer","text":"Most iPhone screen repairs — including the iPhone 16e and 16 Pro Max — take 30 minutes or less. iPad repairs typically take 1-2 hours, and MacBook repairs (Air M4, Pro M4) range from 2-4 hours depending on the service. We offer same-day service for most repairs at our Eisenhower Parkway location."}},{"@type":"Question","name":"Do you offer same-day Apple device repair in Macon?","acceptedAnswer":{"@type":"Answer","text":"Yes! We specialize in same-day repairs for iPhone, iPad, and MacBook devices in 2026. Most iPhone repairs are completed while you wait — no appointment needed. Walk in any time during business hours."}},{"@type":"Question","name":"What areas do you serve besides Macon, GA?","acceptedAnswer":{"@type":"Answer","text":"We serve all of Central Georgia: Macon, Warner Robins, Byron, Forsyth, Perry, Bibb County, Houston County, and Peach County. Located at 3742 Eisenhower Parkway with easy I-75 access from anywhere in the region."}},{"@type":"Question","name":"Are your parts genuine Apple parts or third-party?","acceptedAnswer":{"@type":"Answer","text":"We use premium-grade replacement parts that meet or exceed OEM specifications. For 2026 models like the iPhone 16e and iPad Pro M4, we stock both OEM-equivalent and aftermarket options so you can choose the best fit for your budget. All parts come with a 30-day warranty."}},{"@type":"Question","name":"How much do repairs typically cost in 2026?","acceptedAnswer":{"@type":"Answer","text":"iPhone screen repairs start at $79 (older models) up to $329 (iPhone 16 Pro Max). iPad screen replacement from $99. MacBook repairs from $299. We're typically 30-50% less than Apple Store pricing. Call (478) 259-6371 for an exact quote."}},{"@type":"Question","name":"Do you offer warranties on repairs?","acceptedAnswer":{"@type":"Answer","text":"Every repair comes with our 30-day comprehensive warranty covering both parts and labor. If anything goes wrong with a repair we performed, bring it back and we'll make it right at no extra charge."}},{"@type":"Question","name":"Can you fix water-damaged iPhones and iPads?","acceptedAnswer":{"@type":"Answer","text":"Yes — water damage repair is one of our specialties. We use ultrasonic cleaning and micro-soldering to recover devices other shops turn away. The sooner you bring it in after water exposure, the better the chances of full recovery."}},{"@type":"Question","name":"Do I need an appointment or can I walk in?","acceptedAnswer":{"@type":"Answer","text":"No appointment needed! Walk-ins welcome Monday-Friday 10am-6pm and Saturday 10am-5pm. During busy periods you can call ahead at (478) 259-6371, but most customers are in and out in under an hour."}}]}7:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://techmedicsmacon.com\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$f"}}],["$","h1",null,{"className":"sr-only","children":"iPhone, iPad & MacBook Repair in Macon, GA — Tech Medics"}],"$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c"],null,"$L1d"]}]
